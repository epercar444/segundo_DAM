package Libreria.repositorio;

import java.util.HashSet;
import java.util.Iterator;
import java.util.Set;

import Libreria.modelo.Editorial;
import Libreria.modelo.Libreria_Exception;
import Libreria.modelo.Libro;

public class EditorialRepo {
	private Set<Editorial> editoriales;

	public Set<Editorial> getEditoriales() {
		return editoriales;
	}

	public void setEditoriales(Set<Editorial> editoriales) {
		this.editoriales = editoriales;
	}

	public EditorialRepo() {
		super();
		this.editoriales = new HashSet<Editorial>();
	}
	
	
	public void addEditorial (Editorial e) {
		editoriales.add(e);
	}
	
	public boolean deleteEditorial (String CIF) throws Libreria_Exception {
		boolean esta = true;
		Libro l = leeLibro(ISBN);
		if (l.equals(null)) {
			esta= false;
			throw new Libreria_Exception ("El libro indicado no existe");
		}
		return esta;
	}
	
	public Editorial leeEditorial (String CIF) throws Libreria_Exception {
		boolean encontrado = false;
		Editorial p = null;
		
		Iterator<Editorial> iterator = editoriales.iterator();
			while (!encontrado && iterator.hasNext()) {
				Editorial e = iterator.next();
				if (e.getCIF().equals(CIF)) {
					p = e; 
					encontrado = true;
			}
		}
		return p;
	}
	
	public boolean actualizaLibro (String ISBN,Libro l1) throws Libreria_Exception {
		boolean esta = true;
		Libro l = leeLibro(ISBN);
		if (l.equals(null)) {
			esta= false;
			throw new Libreria_Exception ("El libro indicado no existe");
		}
		else {
			libros.remove(l);
			libros.add(l1);
		}
		return esta;
	}
}

<%- include("templates/cabecera", {subtitulo: 'Panel de Administración'}) %>

    <div class="container">
        <table class="table">
            <thead class="thead-dark">
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Nombre</th>
                    <th scope="col">Tipo</th>
                    <th scope="col">Descripción</th>
                    <th scope="col">Acción</th>
                </tr>
            </thead>
            <tbody>
                <% if (arrayPokemon && arrayPokemon.length > 0) { %>
                    <% arrayPokemon.forEach(pokemon => { %>
                        <tr>
                            <th scope="row"><%= pokemon.id %></th>
                            <td><%= pokemon.nombre %></td>
                            <td><%= pokemon.tipo %></td>
                            <td><%= pokemon.descripcion %></td>
                            <td>Acciones</td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="5" class="text-center">No hay pokemons registrados.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

<%- include("templates/footer") %>
<%- include("templates/cabecera", {subtitulo: 'Nuevo Libro' }) %>
    <div class="container">
        <h1>Crear nuevo Libro</h1>
        <form action="/libro" class="my-2" method="POST">
            <input type="text" placeholder="isbn Libro" class="form-control my-2" name="isbn">
            <input type="text" placeholder="Título Libro" class="form-control my-2" name="titulo">
            <input type="text" placeholder="Autor" class="form-control my-2" name="autor">
            <input type="text" placeholder="Número Páginas Libro" class="form-control my-2" name="numeroPaginas">
            <button type="submit" class="btn btn-dark btn-block">
                Agregar
            </button>
        </form>
    </div>
<%- include("templates/footer") %>
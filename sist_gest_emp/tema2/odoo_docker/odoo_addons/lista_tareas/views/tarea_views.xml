<odoo>

    <!-- Acción para abrir la lista -->
    <record id="action_lista_tareas" model="ir.actions.act_window">
        <field name="name">Lista de tareas</field>
        <field name="res_model">mi_modulo_tareas.tarea</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú principal -->
    <menuitem id="menu_tareas_root"
              name="Tareas"
              sequence="10"/>

    <!-- Submenú -->
    <menuitem id="menu_lista_tareas"
              name="Lista de tareas"
              parent="menu_tareas_root"
              action="action_lista_tareas"
              sequence="10"/>

    <!-- Vista lista -->
    <record id="view_tarea_list" model="ir.ui.view">
        <field name="name">tarea.list</field>
        <field name="model">mi_modulo_tareas.tarea</field>
        <field name="arch" type="xml">
            <list string="Tareas">
                <field name="name"/>
                <field name="estado"/>
                <field name="prioridad"/>
                <field name="fecha_limite"/>
            </list>
        </field>
    </record>

    <!-- Vista formulario -->
    <record id="view_tarea_form" model="ir.ui.view">
        <field name="name">tarea.form</field>
        <field name="model">mi_modulo_tareas.tarea</field>
        <field name="arch" type="xml">
            <form string="Tarea">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="descripcion"/>
                        <field name="estado"/>
                        <field name="prioridad"/>
                        <field name="fecha_limite"/>
                    </group>
                </sheet>

                <footer>
                    <button name="marcar_como_completada"
                            type="object"
                            string="Marcar completada"
                            class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

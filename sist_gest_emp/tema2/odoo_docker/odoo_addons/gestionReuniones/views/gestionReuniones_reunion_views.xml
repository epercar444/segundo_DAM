<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reunion_tree" model="ir.ui.view">
        <field name="name">gestionReuniones.Reunion.tree</field>
        <field name="model">gestionReuniones.Reunion</field>
        <field name="arch" type="xml">
            <list>
                <field name="fecha"/>
                <field name="name"/>
                <field name="sala"/>
                <field name="responsable"/>
                <field name="porcentaje_ocupacion" widget="progressbar"/>
            </list>
        </field>
    </record>

    <record id="view_reunion_form" model="ir.ui.view">
        <field name="name">gestionReuniones.Reunion.form</field>
        <field name="model">gestionReuniones.Reunion</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="fecha"/>
                            <field name="duracion"/>
                        </group>
                        <group>
                            <field name="sala"/>
                            <field name="responsable"/>
                            <field name="asientos"/>
                        </group>
                    </group>
                    <group>
                        <field name="porcentaje_ocupacion" widget="progressbar"/>
                    </group>
                    <notebook>
                        <page string="Asistentes">
                            <field name="asistentes">
                                <list>
                                    <field name="name"/>
                                    <field name="email"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_reunion_search" model="ir.ui.view">
        <field name="name">gestionReuniones.Reunion.search</field>
        <field name="model">gestionReuniones.Reunion</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="sala"/>
                <field name="responsable"/>
                <filter string="Hoy" name="today" domain="[('fecha', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Sala" name="group_by_sala" context="{'group_by': 'sala'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reunion" model="ir.actions.act_window">
        <field name="name">Reuniones</field>
        <field name="res_model">gestionReuniones.Reunion</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
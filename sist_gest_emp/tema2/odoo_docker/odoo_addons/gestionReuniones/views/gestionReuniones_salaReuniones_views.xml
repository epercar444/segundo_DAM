<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sala_reuniones_tree" model="ir.ui.view">
        <field name="name">gestionReuniones.salaReuniones.tree</field>
        <field name="model">gestionReuniones.salaReuniones</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_sala_reuniones_form" model="ir.ui.view">
        <field name="name">gestionReuniones.salaReuniones.form</field>
        <field name="model">gestionReuniones.salaReuniones</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Reuniones Programadas">
                            <field name="reuniones">
                                <list>
                                    <field name="name"/>
                                    <field name="fecha"/>
                                    <field name="responsable"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sala_reuniones_search" model="ir.ui.view">
        <field name="name">gestionReuniones.salaReuniones.search</field>
        <field name="model">gestionReuniones.salaReuniones</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_sala_reuniones" model="ir.actions.act_window">
        <field name="name">Salas de Reuniones</field>
        <field name="res_model">gestionReuniones.salaReuniones</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea la primera sala de reuniones.
            </p>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lista -->
    <record id="hospital_historial_view_list" model="ir.ui.view">
        <field name="name">hospital.historial.list</field>
        <field name="model">hospital.historial</field>
        <field name="arch" type="xml">
            <list>
                <field name="fecha"/>
                <field name="paciente_id"/>
                <field name="medico_id"/>
                <field name="especialidad_id"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Formulario -->
    <record id="hospital_historial_view_form" model="ir.ui.view">
        <field name="name">hospital.historial.form</field>
        <field name="model">hospital.historial</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="fecha"/>
                    </group>
                    <group>
                        <field name="paciente_id"/>
                        <field name="medico_id"/>
                        <field name="especialidad_id"/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Calendario -->
    <record id="hospital_historial_view_calendar" model="ir.ui.view">
        <field name="name">hospital.historial.calendar</field>
        <field name="model">hospital.historial</field>
        <field name="arch" type="xml">
            <calendar date_start="fecha" string="Historiales" color="paciente_id">
                <field name="paciente_id"/>
                <field name="name"/>
            </calendar>
        </field>
    </record>

    <!-- Búsqueda -->
    <record id="hospital_historial_view_search" model="ir.ui.view">
        <field name="name">hospital.historial.search</field>
        <field name="model">hospital.historial</field>
        <field name="arch" type="xml">
            <search>
                <field name="paciente_id"/>
                <field name="medico_id"/>
                <field name="especialidad_id"/>
                <filter string="Agrupar por paciente" name="group_by_paciente"
                        context="{'group_by': 'paciente_id'}"/>
            </search>
        </field>
    </record>

    <!-- Acción -->
    <record id="hospital_action_historial" model="ir.actions.act_window">
        <field name="name">Historiales</field>
        <field name="res_model">hospital.historial</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="search_view_id" ref="hospital_historial_view_search"/>
    </record>
</odoo>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lista (tree) -->
    <record id="hospital_especialidad_view_tree" model="ir.ui.view">
        <field name="name">hospital.especialidad.tree</field>
        <field name="model">hospital.especialidad</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- Formulario (form) -->
    <record id="hospital_especialidad_view_form" model="ir.ui.view">
        <field name="name">hospital.especialidad.form</field>
        <field name="model">hospital.especialidad</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Historiales">
                            <field name="historial_ids">
                                <list editable="bottom">
                                    <field name="fecha"/>
                                    <field name="paciente_id"/>
                                    <field name="medico_id"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Búsqueda (search): buscar por nombre -->
    <record id="hospital_especialidad_view_search" model="ir.ui.view">
        <field name="name">hospital.especialidad.search</field>
        <field name="model">hospital.especialidad</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- Acción de ventana -->
    <record id="hospital_action_especialidad" model="ir.actions.act_window">
        <field name="name">Especialidades</field>
        <field name="res_model">hospital.especialidad</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hospital_especialidad_view_search"/>
    </record>
</odoo>

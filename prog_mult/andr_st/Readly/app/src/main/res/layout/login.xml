<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainLogin">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F3F3F3"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Readly"
            android:textSize="32sp"
            android:textStyle="bold|italic"
            android:textColor="#000000"
            android:layout_marginTop="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tu biblioteca digital en un click"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textSize="16sp"
            android:layout_marginBottom="40dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crear una cuenta"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textSize="18sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Introduce tu correo electrónico para registrarte en esta aplicación"
            android:textAlignment="center"
            android:layout_marginTop="6dp"
            android:textColor="#555555"
            android:textSize="14sp"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="25dp"
            android:background="#FFFFFF"
            android:hint="email@domain.com"
            android:paddingHorizontal="16dp"
            android:textColor="#000000"
            android:textColorHint="#999999"
            android:inputType="textEmailAddress"/>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:hint="email@domain.com"
            android:paddingHorizontal="16dp"
            android:textColor="#000000"
            android:textColorHint="#999999"
            android:inputType="textEmailAddress"/>

        <Button
            android:id="@+id/btn_cln"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#000000"
            android:stateListAnimator="@null"
            android:text="Continuar como cliente"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_admin"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#000000"
            android:stateListAnimator="@null"
            android:text="Continuar como administrador"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:background="#A9A9A9" />

        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#EEEEEE"
            android:text="Continuar con Google"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="8dp"
            app:elevation="0dp"

            app:icon="@drawable/ic_google"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@null"
            />

        <com.google.android.material.button.MaterialButton
            android:layout_marginTop="15dp"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#EEEEEE"
            android:text="Continuar con Apple"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="8dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_apple"
            app:iconSize="33dp"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@null"
            />

        <Button
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#000000"
            android:stateListAnimator="@null"
            android:text="¿Ya tienes cuenta?"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Al hacer clic en continuar, aceptas nuestros Términos de Servicio y nuestra Política de Privacidad"
            android:textAlignment="center"
            android:textColor="#888888"
            android:textSize="12sp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
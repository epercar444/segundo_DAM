<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFC107"
    tools:context=".MainActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="200px"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:id="@+id/textoLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="25dp"
            android:layout_marginEnd="15dp"
            android:text="AppTusam"
            android:textSize="50dp"
            android:textStyle="italic"
            android:typeface="sans"
            app:layout_constraintEnd_toEndOf="parent" />
        <TextView
            android:id="@+id/seleccionarOpcion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:text="Seleccione una opción"
            android:textSize="20dp"
            android:textStyle="italic"
            android:typeface="sans"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/consultaLineas"
            android:layout_width="300dp"
            android:layout_height="54dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="15dp"
            android:text="Consulta Lineas"
            android:backgroundTint="#87FF9800"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/seleccionarOpcion" />
        <Button
            android:id="@+id/consultaAutobus"
            android:layout_width="300dp"
            android:layout_height="54dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:text="Consulta Autobus"
            android:backgroundTint="#87FF9800"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/consultaLineas" />
        <Button
            android:id="@+id/consultaHorario"
            android:layout_width="300dp"
            android:layout_height="54dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:text="Consulta Horario"
            android:backgroundTint="#87FF9800"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/consultaAutobus" />
        <Button
            android:id="@+id/volver"
            android:layout_width="300dp"
            android:layout_height="54dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:text="Atrás"
            android:backgroundTint="#87FF9800"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/consultaHorario" />
    </LinearLayout>




</androidx.constraintlayout.widget.ConstraintLayout>